---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Dépannage & Services Plomberie à Namur | Tous nos services" 
  description="Découvrez l'ensemble de nos services : dépannage urgent, débouchage, recherche de fuite, chauffage, sanitaire et traitement de l'eau à Namur."
>
  <div class="page-header text-center">
    <div class="container">
      <h1>Tous nos Services de Plomberie</h1>
      <p class="subtitle">Des solutions expertes pour tous vos problèmes. Cliquez sur un service pour découvrir nos prestations détaillées.</p>
    </div>
  </div>

  <div class="container section">
    
    <div class="grid grid-3">
      
      <!-- Urgence -->
      <a href="/services/urgence" class="service-card-link card text-center">
        <div class="service-icon">🚨</div>
        <h2>Dépannage d'Urgence</h2>
        <p>Intervention 24/7 en moins de 30 minutes. Fuites d'eau majeures, pannes, dégâts des eaux.</p>
        <span class="read-more">En savoir plus &rarr;</span>
      </a>

      <!-- Débouchage -->
      <a href="/services/debouchage" class="service-card-link card text-center">
        <div class="service-icon">🚽</div>
        <h2>Débouchage Canalisation</h2>
        <p>Débouchage de WC, éviers, égouts. Curage haute pression et inspection caméra.</p>
        <span class="read-more">En savoir plus &rarr;</span>
      </a>

      <!-- Fuites -->
      <a href="/services/fuites" class="service-card-link card text-center">
        <div class="service-icon">💧</div>
        <h2>Détection de Fuites</h2>
        <p>Recherche non destructive par caméra thermique et acoustique. Rapports d'assurance.</p>
        <span class="read-more">En savoir plus &rarr;</span>
      </a>

      <!-- Chauffage -->
      <a href="/services/chauffage" class="service-card-link card text-center">
        <div class="service-icon">🔥</div>
        <h2>Chauffage & Chaudières</h2>
        <p>Installation, entretien annuel et dépannage urgent de chaudières (gaz/mazout).</p>
        <span class="read-more">En savoir plus &rarr;</span>
      </a>

      <!-- Sanitaire -->
      <a href="/services/sanitaire" class="service-card-link card text-center">
        <div class="service-icon">🚿</div>
        <h2>Installations Sanitaires</h2>
        <p>Rénovation complète de salles de bain, installation de douches, baignoires et WC.</p>
        <span class="read-more">En savoir plus &rarr;</span>
      </a>

      <!-- Traitement d'eau -->
      <a href="/services/traitement-eau" class="service-card-link card text-center">
        <div class="service-icon">🧊</div>
        <h2>Traitement de l'Eau</h2>
        <p>Installation d'adoucisseurs d'eau et de systèmes anti-calcaire pour protéger votre maison.</p>
        <span class="read-more">En savoir plus &rarr;</span>
      </a>

    </div>

    <!-- CTA -->
    <div class="cta-box text-center mt-4">
      <h2>Besoin d'un devis immédiat ?</h2>
      <p style="margin-bottom: 1.5rem;">Notre équipe est à votre disposition pour vous conseiller et vous fournir une estimation gratuite.</p>
      <a href="/contact" class="btn btn-primary">Demander un Devis</a>
    </div>

  </div>
</Layout>

<style>
  .page-header {
    background-color: var(--primary);
    color: white;
    padding: 6rem 1rem 4rem;
  }
  
  .page-header h1 {
    color: white;
    margin-bottom: 1rem;
  }
  
  .subtitle {
    color: rgba(255,255,255,0.8);
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto;
  }
  
  .service-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 1.5rem;
  }
  
  .service-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }
  
  .service-card-link h2 {
    font-size: 1.5rem;
    color: var(--primary);
    margin-bottom: 1rem;
  }
  
  .service-card-link p {
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }
  
  .read-more {
    color: var(--secondary);
    font-weight: 600;
    font-family: var(--font-heading);
    margin-top: auto;
    transition: transform 0.3s;
  }
  
  .service-card-link:hover .read-more {
    transform: translateX(5px);
  }
  
  .cta-box {
    background: var(--bg-light);
    padding: 4rem 2rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-light);
  }
  
  .mt-4 {
    margin-top: 4rem;
  }
</style>
