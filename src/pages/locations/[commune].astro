---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BUSINESS_CONFIG } from '../../data/business';
import { LOCATIONS_DATA, type LocationDetail } from '../../data/locationsData';

export function getStaticPaths() {
  return Object.values(LOCATIONS_DATA).map((loc) => ({
    params: { commune: loc.slug },
    props: { location: loc }
  }));
}

interface Props {
  location: LocationDetail;
}

const { location } = Astro.props;
---

<Layout 
  title={location.metaTitle} 
  description={location.metaDescription}
  schemaType="location"
  areaServedName={`${location.name} (${location.postalCode})`}
>
  <Breadcrumbs items={[
    { name: "Zones d'Intervention", url: "/locations" },
    { name: location.name }
  ]} />

  <div class="page-header text-center">
    <div class="container">
      <span class="badge badge-red mb-2">Service de Proximité Grand Namur</span>
      <h1>{location.h1}</h1>
      <p class="subtitle">{location.lead}</p>
      <div class="mt-4">
        <a href={BUSINESS_CONFIG.telephoneHref} class="btn btn-primary" style="font-size: 1.25rem; padding: 0.9rem 2rem;" data-location="location_header_phone">
          📞 Appeler SOS Plombier {location.name} : {BUSINESS_CONFIG.telephone}
        </a>
      </div>
    </div>
  </div>

  <div class="container section">
    
    <!-- Local Context & Housing Specifications -->
    <div class="grid grid-2 mb-4 align-start">
      <div>
        <h2>Spécificités Techniques & Accès à {location.name}</h2>
        <p>{location.housingAndPlumbingContext}</p>
        
        <div class="card mt-2 bg-light border-0">
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">📍 Quartiers & Voies d'Accès Principales</h3>
          <p style="margin-bottom: 0.5rem;"><strong>Axes routiers :</strong> {location.accessRoutes.join(' • ')}</p>
          <p style="margin: 0;"><strong>Quartiers desservis :</strong> {location.neighbourhoods.join(', ')}.</p>
        </div>

        <div class="card mt-2 bg-light border-0">
          <h3 style="color: var(--secondary); margin-bottom: 0.5rem;">💧 Qualité de l'Eau & Réseau</h3>
          <p style="margin: 0;">{location.waterContext}</p>
        </div>
      </div>

      <div class="card local-emergency-box">
        <h3>🚨 Consignes d'Urgence à {location.name}</h3>
        <p>{location.emergencyGuidance}</p>
        
        <div class="emergency-steps mt-2">
          <h4>En cas de fuite importante :</h4>
          <ol>
            <li>Fermez immédiatement la vanne d'arrêt générale avant-compteur.</li>
            <li>Coupez le disjoncteur électrique de la pièce si l'eau s'approche des prises.</li>
            <li>Appelez notre permanence au <strong>{BUSINESS_CONFIG.telephone}</strong> pour une mise en sécurité rapide.</li>
          </ol>
        </div>

        <div class="mt-4 text-center">
          <a href="/contact" class="btn btn-outline" style="width: 100%;">
            Demander un devis en ligne
          </a>
        </div>
      </div>
    </div>

    <!-- Frequent Interventions in this Commune -->
    <div class="mb-4">
      <h2 class="text-center mb-4">Interventions Courantes à {location.name} ({location.postalCode})</h2>
      <div class="grid grid-2" style="gap: 1.5rem;">
        {location.frequentInterventions.map((item, idx) => (
          <div class="card intervention-item">
            <span class="check-bullet" aria-hidden="true">✓</span>
            <div>
              <strong>Prestation {idx + 1}</strong>
              <p style="margin: 0.25rem 0 0; color: var(--text-main);">{item}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Core Services grid with contextual internal links -->
    <div class="mt-4 mb-4">
      <h2 class="text-center mb-4">Nos Domaines d'Expertise à {location.name}</h2>
      <div class="grid grid-3">
        <div class="card text-center">
          <span style="font-size: 2.5rem;" aria-hidden="true">🚨</span>
          <h3>Dépannage d'Urgence</h3>
          <p>Dégât des eaux, fuite majeure, robinet d'arrêt cassé. Sécurisation immédiate de votre habitation.</p>
          <a href="/services/urgence" class="service-context-link">Voir le Dépannage Urgent &rarr;</a>
        </div>
        <div class="card text-center">
          <span style="font-size: 2.5rem;" aria-hidden="true">🚽</span>
          <h3>Débouchage & Curage</h3>
          <p>Canalisations d'eaux usées, WC, siphons et égouts. Curage haute pression et caméra vidéo.</p>
          <a href="/services/debouchage" class="service-context-link">Voir le Débouchage &rarr;</a>
        </div>
        <div class="card text-center">
          <span style="font-size: 2.5rem;" aria-hidden="true">🔥</span>
          <h3>Chauffage & Chaudière</h3>
          <p>Dépannage de pannes de chaudière, radiateurs froids et contrôles périodiques conformes en Wallonie.</p>
          <a href="/services/chauffage" class="service-context-link">Voir nos Services Chauffage &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Unique Local FAQs -->
    <div class="faq-section mt-4 card">
      <h2 class="text-center mb-4">Questions Fréquentes à {location.name}</h2>
      <div class="faq-list" style="display: flex; flex-direction: column; gap: 1.5rem;">
        {location.faqs.map((faq) => (
          <div class="faq-item">
            <h3 style="color: var(--primary); font-size: 1.15rem; margin-bottom: 0.4rem;">{faq.question}</h3>
            <p style="margin: 0; line-height: 1.6; color: var(--text-main);">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contextual advice guides for this commune -->
    <div class="card mt-4 p-4 bg-light border-0">
      <h3 style="color: var(--primary); margin-bottom: 1rem;">Guides & Conseils Pratiques pour les Habitants de {location.name}</h3>
      <div class="grid grid-3" style="gap: 1rem;">
        <a href="/conseils/combien-coute-un-plombier-namur-2026" class="card" style="text-decoration: none; color: inherit; padding: 1.25rem;">
          <strong style="color: var(--primary);">Tarifs Plombier 2026 &rarr;</strong>
          <p style="margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--text-muted);">Estimation transparente avant travaux et forfaits dépannage d'urgence.</p>
        </a>
        <a href="/conseils/combien-coute-debouchage-canalisation-namur" class="card" style="text-decoration: none; color: inherit; padding: 1.25rem;">
          <strong style="color: var(--primary);">Débouchage & Curage &rarr;</strong>
          <p style="margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--text-muted);">Solutions furet et camion hydrocurage pour WC et colonnes d'évacuation.</p>
        </a>
        <a href="/conseils/eau-calcaire-namur-adoucisseur-combien-ca-coute" class="card" style="text-decoration: none; color: inherit; padding: 1.25rem;">
          <strong style="color: var(--primary);">Calcaire & Adoucisseurs &rarr;</strong>
          <p style="margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--text-muted);">Dureté de l'eau dans le Namurois et protection de vos chauffe-eaux.</p>
        </a>
      </div>
    </div>

    <!-- Neighboring Communes Navigation -->
    <div class="nearby-communes mt-4 text-center">
      <h3>Communes limitrophes également couvertes :</h3>
      <div class="nearby-links mt-2">
        {location.nearbyCommunes.map((near) => (
          <a href={`/locations/${near.slug}`} class="btn btn-outline" style="margin: 0.3rem;">
            Plombier {near.name}
          </a>
        ))}
        <a href="/locations" class="btn btn-outline" style="margin: 0.3rem;">
          Toutes les zones &rarr;
        </a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .page-header {
    background-color: var(--primary);
    color: white;
    padding: 5rem 1rem 3.5rem;
  }
  
  .page-header h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 2.2rem;
  }
  
  .subtitle {
    color: rgba(255,255,255,0.85);
    font-size: 1.15rem;
    max-width: 750px;
    margin: 0 auto;
  }

  .align-start {
    align-items: start;
  }

  .local-emergency-box {
    border-top: 4px solid var(--secondary);
    background: white;
    padding: 2rem;
  }

  .local-emergency-box h3 {
    color: var(--secondary);
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
  }

  .emergency-steps {
    background: var(--bg-light);
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .emergency-steps h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: var(--primary);
  }

  .emergency-steps ol {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .intervention-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border-light);
  }

  .check-bullet {
    background: var(--secondary);
    color: white;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-weight: bold;
    flex-shrink: 0;
  }

  .service-context-link {
    font-weight: 600;
    color: var(--secondary);
    text-decoration: none;
    display: inline-block;
    margin-top: 0.75rem;
  }

  .service-context-link:hover {
    text-decoration: underline;
  }

  .faq-list .faq-item {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 1.25rem;
  }

  .faq-list .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .nearby-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .mb-2 { margin-bottom: 0.5rem; }
  .mb-4 { margin-bottom: 2.5rem; }
  .mt-2 { margin-top: 1rem; }
  .mt-4 { margin-top: 2.5rem; }
  .bg-light { background-color: var(--bg-light); }
  .border-0 { border: none; box-shadow: none; }
</style>
