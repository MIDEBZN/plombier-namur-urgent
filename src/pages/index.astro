---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
---

<Layout 
  title="Plombier Namur : Dépannage Urgent 24/7 & Installation" 
  description="Entreprise de plomberie à Namur. Dépannage urgent 24/7, débouchage canalisation, recherche de fuite et entretien chaudière. Devis gratuit !"
>
  <!-- HERO SECTION -->
  <section class="hero flex-center">
    <div class="container grid grid-2 hero-grid">
      <div class="hero-content animate-fade-in">
        <span class="badge badge-red">🚀 Intervention en 30 Minutes</span>
        <h1>Votre <span class="text-secondary">Plombier Chauffagiste</span> de Confiance à Namur</h1>
        <p class="hero-text">
          Vous cherchez le meilleur plombier à Namur ? Nous intervenons 24h/24 et 7j/7 pour toutes vos urgences : fuites d'eau, canalisations bouchées, pannes de chaudière. <strong>Devis gratuit et prix transparents.</strong>
        </p>
        <div class="hero-actions">
          <a href="tel:+32470000000" class="btn btn-primary">
            Appelez-nous : 0470 00 00 00
          </a>
          <a href="/contact" class="btn btn-outline">
            Demander un Devis
          </a>
        </div>
        <div class="trust-signals flex-center" style="justify-content: flex-start; gap: 1.5rem; margin-top: 2rem;">
           <div class="trust-item">
             <strong>⭐ 4.9/5</strong><br/>
             <span>Avis Clients</span>
           </div>
           <div class="trust-item">
             <strong>🏆 25+ Ans</strong><br/>
             <span>d'Expérience</span>
           </div>
           <div class="trust-item">
             <strong>✅ Agréé</strong><br/>
             <span>Assurances</span>
           </div>
        </div>
      </div>
      <div class="hero-image animate-fade-in" style="animation-delay: 0.2s;">
        <!-- Placeholder for hero image. Image should feature a professional plumber -->
        <div class="image-wrapper" style="position: relative;">
          <Image 
            src={heroImage} 
            alt="Plombier professionnel en intervention" 
            width={800} 
            height={500} 
            format="webp" 
            loading="eager" 
            fetchpriority="high"
            style="width: 100%; height: 500px; object-fit: cover; border-radius: var(--radius-xl);" 
          />
          <div class="glass-panel experience-card">
             <span style="font-size: 2rem;">🛠️</span>
             <div>
               <strong>Service de Plomberie</strong>
               <p style="margin:0; font-size: 0.85rem;">Qualité Garantie</p>
             </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS & BADGES SECTION -->
  <section class="stats-strip bg-light">
    <div class="container grid grid-4 text-center" style="gap: 1rem; padding: 2rem 0; align-items: center;">
      <div>
        <div style="font-size: 2rem; color: #facc15;">★★★★★</div>
        <strong>4.9/5 sur Google Avis</strong>
      </div>
      <div>
        <div style="font-size: 2.2rem; line-height: 1;">⏱️</div>
        <strong>92% d'interventions en &lt; 30 min</strong>
      </div>
      <div>
        <div style="font-size: 2.2rem; line-height: 1;">🛡️</div>
        <strong>100% Agréé & Assurances</strong>
      </div>
      <div>
        <div style="font-size: 2.2rem; line-height: 1;">✅</div>
        <strong>Garantie Satisfait ou Refait</strong>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="section process-section">
    <div class="container text-center">
      <h2>Comment Ça Marche ?</h2>
      <p style="max-width: 600px; margin: 0 auto 3rem;">Un processus simple et transparent pour résoudre vos problèmes de plomberie sans stress.</p>
      
      <div class="grid grid-4">
        <div class="process-step card">
          <div class="step-icon">📞</div>
          <h3>1. Contact</h3>
          <p>Appelez-nous ou demandez un devis en ligne gratuitement.</p>
        </div>
        <div class="process-step card">
          <div class="step-icon">⏱️</div>
          <h3>2. Intervention</h3>
          <p>Un plombier agréé se rend chez vous en moins de 30 minutes en cas d'urgence.</p>
        </div>
        <div class="process-step card">
          <div class="step-icon">📋</div>
          <h3>3. Diagnostic & Devis</h3>
          <p>Nous identifions le problème et vous proposons un devis clair et sans surprise.</p>
        </div>
        <div class="process-step card">
          <div class="step-icon">✅</div>
          <h3>4. Réparation</h3>
          <p>Le travail est effectué avec soin, propreté et garanti pour votre tranquillité.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES SECTION -->
  <section class="section services-section bg-light">
    <div class="container text-center">
      <h2>Nos Services de Plomberie à Namur</h2>
      <p style="max-width: 600px; margin: 0 auto 3rem;">Des solutions complètes pour tous vos besoins en sanitaires et chauffage.</p>
      
      <div class="grid grid-3">
        <div class="card service-card">
          <div class="service-icon">🚨</div>
          <h3>Dépannage Urgent 24/7</h3>
          <p>Intervention rapide pour toute urgence plomberie namur. Fuite d'eau, canalisation explosée, nous sommes là.</p>
          <a href="/services#urgence" class="service-link">En savoir plus &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon">🚽</div>
          <h3>Débouchage Canalisation</h3>
          <p>WC bouché ? Évier engorgé ? Nous utilisons une inspection caméra et haute pression pour un résultat impeccable.</p>
          <a href="/services#debouchage" class="service-link">En savoir plus &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon">💧</div>
          <h3>Recherche de Fuite</h3>
          <p>Détection de fuite non destructive grâce à nos équipements de pointe. Réparation rapide garantie.</p>
          <a href="/services#fuites" class="service-link">En savoir plus &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon">🔥</div>
          <h3>Chauffagiste Namur</h3>
          <p>Entretien chaudière, réparation, dépannage et installation complète de systèmes de chauffage.</p>
          <a href="/services#chauffage" class="service-link">En savoir plus &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon">🚿</div>
          <h3>Installation Sanitaire</h3>
          <p>Rénovation de salle de bain, installation de chauffe-eau, remplacement de robinetterie.</p>
          <a href="/services" class="service-link">En savoir plus &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE MAP SECTION -->
  <section class="section">
    <div class="container grid grid-2" style="align-items: center;">
      <div>
        <h2>Notre Zone d'Intervention à Namur</h2>
        <p>Nous sommes basés stratégiquement pour couvrir l'ensemble du Grand Namur le plus rapidement possible. Notre promesse : un plombier chez vous en 30 minutes pour les urgences.</p>
        <ul class="styled-list mt-2">
          <li><strong>Namur Centre & Périphérie :</strong> Jambes, Erpent, Salzinnes...</li>
          <li><strong>Intervention express :</strong> Flotte de camionnettes géolocalisées.</li>
          <li><strong>Déplacement 100% gratuit :</strong> Si vous acceptez notre devis.</li>
        </ul>
        <a href="/locations" class="btn btn-outline" style="margin-top: 1rem;">Voir toutes nos zones</a>
      </div>
      <div class="map-visual card" style="padding: 0; overflow: hidden; border-radius: var(--radius-xl); min-height: 350px;">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2734.5718181503753!2d4.88035337655836!3d50.469380271595845!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4214adee153effdb%3A0x9e30187e3d45e862!2sCitabat%20Plombier%20Namur%20Urgent!5e1!3m2!1sen!2sbe!4v1788303865276!5m2!1sen!2sbe" width="100%" height="100%" style="border:0; min-height: 350px; display: block;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="section bg-light">
    <div class="container text-center">
      <h2>Ce que disent nos clients</h2>
      <p style="max-width: 600px; margin: 0 auto 3rem;">Lisez les avis de Namurois qui ont fait appel à nos services.</p>
      
      <div class="grid grid-3 text-left">
        <div class="card">
          <div style="color: #facc15; font-size: 1.25rem; margin-bottom: 0.5rem;">★★★★★</div>
          <p>"Canalisation complètement bouchée un dimanche soir. Le plombier est arrivé en 25 minutes et a réglé le problème avec une caméra. Prix annoncé à l'avance. Très pro !"</p>
          <strong>- Marc D. (Jambes)</strong>
        </div>
        <div class="card">
          <div style="color: #facc15; font-size: 1.25rem; margin-bottom: 0.5rem;">★★★★★</div>
          <p>"J'avais une fuite sous ma baignoire. Ils ont trouvé la fuite sans rien casser grâce à leur caméra thermique. Dossier nickel pour mon assurance."</p>
          <strong>- Sophie L. (Namur Centre)</strong>
        </div>
        <div class="card">
          <div style="color: #facc15; font-size: 1.25rem; margin-bottom: 0.5rem;">★★★★★</div>
          <p>"Chaudière en panne en plein hiver. Le chauffagiste avait la pièce dans sa camionnette. Réparation immédiate. Je recommande Plombier Namur Urgent à 100%."</p>
          <strong>- Thomas W. (Erpent)</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="section cta-section text-center">
    <div class="container">
      <h2>Besoin d'un Plombier Pas Cher et Fiable ?</h2>
      <p style="font-size: 1.2rem; margin-bottom: 2rem;">Ne laissez pas un dégât des eaux ruiner votre journée. Obtenez un prix de plombier à Namur transparent et juste.</p>
      <a href="tel:+32470000000" class="btn btn-primary" style="font-size: 1.25rem; padding: 1rem 2rem;">
        Urgence : 0470 00 00 00
      </a>
    </div>
  </section>

</Layout>

<style>
  .text-secondary {
    color: var(--secondary);
  }
  
  .bg-light {
    background-color: #f1f5f9;
  }
  
  .hero {
    min-height: 85vh;
    padding: 2rem 0;
    position: relative;
    overflow: hidden;
  }
  
  /* Decorative background blob */
  .hero::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(37,99,235,0.08) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    z-index: -1;
  }
  
  .hero-grid {
    align-items: center;
  }
  
  .hero-text {
    font-size: 1.125rem;
    margin: 1.5rem 0 2.5rem;
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .image-placeholder {
    width: 100%;
    height: 500px;
    background: linear-gradient(135deg, var(--border-light) 0%, #cbd5e1 100%);
    border-radius: var(--radius-xl);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .image-placeholder::after {
    content: 'Hero Image (Plumber at work)';
    color: var(--text-muted);
    font-weight: 600;
  }
  
  .experience-card {
    position: absolute;
    bottom: -20px;
    left: -20px;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: var(--shadow-lg);
  }
  
  .step-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  
  .service-card {
    text-align: left;
  }
  
  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--primary);
  }
  
  .service-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    font-family: var(--font-heading);
  }
  
  .cta-section {
    background: var(--primary);
    color: white;
    padding: 6rem 1rem;
  }
  
  .cta-section h2 {
    color: white;
  }
  
  .cta-section p {
    color: rgba(255,255,255,0.8);
  }
  
  .styled-list {
    list-style: none;
    padding: 0;
  }
  
  .styled-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .styled-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--secondary);
    font-weight: bold;
    font-size: 1.2rem;
  }
  
  .mt-2 { margin-top: 1rem; }
  
  @media (max-width: 768px) {
    .stats-strip .grid-4 {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
  }
</style>
