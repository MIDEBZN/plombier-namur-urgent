---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import GlobalMap from '../components/GlobalMap.astro';
import { BUSINESS_CONFIG } from '../data/business';

const homeFaqs = [
  {
    question: "Quel est le prix d'un dépannage plombier à Namur ?",
    answer: "Le tarif d'une intervention à Namur dépend du type de panne : un débouchage manuel commence à partir de 75€, une recherche de fuite sans casse à partir de 65€, tandis que le curage haute pression ou les dépannages nocturnes font l'objet d'une estimation préalable. Le devis est systématiquement présenté avant le début des travaux."
  },
  {
    question: "Quand faut-il appeler un plombier en urgence 24/7 ?",
    answer: "Une intervention d'urgence 24/7 se justifie immédiatement en cas de tuyau percé avec inondation active, de refoulement d'égout dans votre logement, ou de panne totale de chauffage en plein hiver avec des personnes vulnérables. Pour un robinet qui goutte légèrement, une prise de rendez-vous en journée permet d'éviter les majorations de nuit."
  },
  {
    question: "Comment savoir si une canalisation est bouchée ?",
    answer: "Les signes annonciateurs sont un écoulement ralenti dans l'évier ou la douche, des bruits d'aspiration (glouglou) dans les canalisations, des mauvaises odeurs persistantes, ou une eau qui remonte dans les toilettes lorsque la chasse est actionnée."
  }
];
---

<Layout 
  title="Plombier Namur 24/7 | Urgence, Débouchage & Chauffage" 
  description="Entreprise de plomberie et chauffage à Namur. Dépannage d'urgence 24/7, débouchage canalisation, recherche de fuite sans casse et chaudières. Devis transparent."
  schemaType="home"
  faq={homeFaqs}
  showGlobalMap={false}
>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content animate-fade-in">
        <span class="badge badge-red mb-2">🚀 Permanence Dépannage 24/7</span>
        <h1>Plombier à Namur 24/7 : dépannage, débouchage et chauffage</h1>
        <p class="hero-text">
          Une fuite d'eau soudaine, une canalisation bouchée ou une chaudière en panne ? Notre équipe d'artisans qualifiés intervient rapidement dans tout le Grand Namur. <strong>Devis clair et transparent avant toute intervention.</strong>
        </p>
        <div class="hero-actions">
          <a href={BUSINESS_CONFIG.telephoneHref} class="btn btn-primary" data-location="home_hero_phone">
            Appelez-nous : {BUSINESS_CONFIG.telephone}
          </a>
          <a href="/contact" class="btn btn-outline" data-location="home_hero_quote">
            Demander un Devis Gratuit
          </a>
        </div>
        <div class="trust-signals">
           <div class="trust-item">
             <strong>⭐ Avis Clients</strong><br/>
             <a href={BUSINESS_CONFIG.googleBusinessProfileUrl} target="_blank" rel="noopener noreferrer">Consulter sur Google Maps</a>
           </div>
           <div class="trust-item">
             <strong>🏆 Métier</strong><br/>
             <span>Techniciens Qualifiés</span>
           </div>
           <div class="trust-item">
             <strong>✅ Assurances</strong><br/>
             <span>Rapports d'Intervention</span>
           </div>
        </div>
      </div>
      <div class="hero-image animate-fade-in" style="animation-delay: 0.2s;">
        <div class="image-wrapper">
          <Image 
            src={heroImage} 
            alt="Plombier professionnel en intervention d'urgence à Namur" 
            width={800} 
            height={500} 
            format="webp" 
            loading="eager" 
            fetchpriority="high"
            class="hero-photo"
          />
          <div class="glass-panel experience-card">
             <span class="experience-icon" aria-hidden="true">🛠️</span>
             <div>
               <strong>Service Plomberie Namur</strong>
               <p>Grand Namur & Alentours</p>
             </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS & BADGES SECTION -->
  <section class="stats-strip bg-light" aria-label="Engagements de service">
    <div class="container grid grid-4 text-center" style="gap: 1rem; padding: 2rem 0; align-items: center;">
      <div>
        <div style="font-size: 2rem; color: #facc15;" aria-hidden="true">★★★★★</div>
        <strong>Avis Google Vérifiés</strong>
      </div>
      <div>
        <div style="font-size: 2.2rem; line-height: 1;" aria-hidden="true">⏱️</div>
        <strong>Permanence 24/7 Namur</strong>
      </div>
      <div>
        <div style="font-size: 2.2rem; line-height: 1;" aria-hidden="true">🛡️</div>
        <strong>Dossiers Assurances Conformes</strong>
      </div>
      <div>
        <div style="font-size: 2.2rem; line-height: 1;" aria-hidden="true">📋</div>
        <strong>Devis Détaillé Avant Travaux</strong>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="section process-section">
    <div class="container text-center">
      <h2>Comment se déroule notre intervention ?</h2>
      <p style="max-width: 600px; margin: 0 auto 3rem;">Un processus transparent pour résoudre vos urgences de plomberie avec clarté et sécurité.</p>
      
      <div class="grid grid-4">
        <div class="process-step card">
          <div class="step-icon" aria-hidden="true">📞</div>
          <h3>1. Appel & Conseil</h3>
          <p>Vous nous décrivez votre problème. Nous vous conseillons les premiers réflexes (ex: couper l'eau) et vous donnons une estimation.</p>
        </div>
        <div class="process-step card">
          <div class="step-icon" aria-hidden="true">⏱️</div>
          <h3>2. Déplacement</h3>
          <p>Un technicien qualifié prend la route vers votre domicile dans le Grand Namur avec un véhicule tout équipé.</p>
        </div>
        <div class="process-step card">
          <div class="step-icon" aria-hidden="true">📋</div>
          <h3>3. Diagnostic & Devis</h3>
          <p>Nous identifions la panne sur place et vous soumettons un devis précis avant de commencer les réparations.</p>
        </div>
        <div class="process-step card">
          <div class="step-icon" aria-hidden="true">✅</div>
          <h3>4. Réparation</h3>
          <p>L'intervention est réalisée dans les règles de l'art, le chantier est nettoyé et nous vous remettons votre facture.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES SECTION -->
  <section class="section services-section bg-light" id="services">
    <div class="container text-center">
      <h2>Nos Services de Plomberie et Chauffage à Namur</h2>
      <p style="max-width: 600px; margin: 0 auto 3rem;">Des prestations complètes pour le dépannage d'urgence, l'entretien et la rénovation sanitaire.</p>
      
      <div class="grid grid-3">
        <div class="card service-card">
          <div class="service-icon" aria-hidden="true">🚨</div>
          <h3>Dépannage Urgent 24/7</h3>
          <p>Intervention rapide pour fuite majeure, canalisation éclatée, robinet cassé ou inondation dans tout le Namurois.</p>
          <a href="/services/urgence" class="service-link">Voir le dépannage plomberie 24/7 &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon" aria-hidden="true">🚽</div>
          <h3>Débouchage Canalisation</h3>
          <p>WC bouché, évier engorgé, refoulement d'égout. Curage haute pression et inspection caméra endoscopique.</p>
          <a href="/services/debouchage" class="service-link">Voir le service de débouchage &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon" aria-hidden="true">💧</div>
          <h3>Recherche de Fuite</h3>
          <p>Détection non destructive par caméra thermique, acoustique et gaz traceur pour vos murs, sols et plafonds.</p>
          <a href="/services/fuites" class="service-link">Voir la recherche de fuite sans casse &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon" aria-hidden="true">🔥</div>
          <h3>Chauffagiste Namur</h3>
          <p>Contrôle périodique conforme Région Wallonne, dépannage de chaudières gaz et mazout, désembouage radiateurs.</p>
          <a href="/services/chauffage" class="service-link">Voir nos services de chauffage &rarr;</a>
        </div>
        
        <div class="card service-card">
          <div class="service-icon" aria-hidden="true">🚿</div>
          <h3>Installation Sanitaire</h3>
          <p>Rénovation de salle de bain, pose de douche italienne, remplacement de robinetterie et boilers thermodynamiques.</p>
          <a href="/services/sanitaire" class="service-link">Voir les installations sanitaires &rarr;</a>
        </div>

        <div class="card service-card">
          <div class="service-icon" aria-hidden="true">🧊</div>
          <h3>Traitement de l'Eau</h3>
          <p>Installation d'adoucisseurs d'eau à sel ou CO2 adaptés à l'eau calcaire de Namur. Protection de votre plomberie.</p>
          <a href="/services/traitement-eau" class="service-link">Voir le traitement de l'eau et adoucisseurs &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE MAP SECTION -->
  <section class="section" aria-label="Zone de couverture">
    <div class="container grid grid-2" style="align-items: center;">
      <div>
        <h2>Notre Zone d'Intervention dans le Grand Namur</h2>
        <p>Basés dans l'agglomération namuroise, nous intervenons rapidement sur les deux rives de la Meuse et de la Sambre :</p>
        <ul class="styled-list mt-2">
          <li><strong>Namur Centre & Faubourgs :</strong> 5000 Namur, Salzinnes, Saint-Servais.</li>
          <li><strong>Rive Droite & Hauteurs :</strong> Jambes (5100), Erpent (5101), Bouge (5004).</li>
          <li><strong>Périphérie :</strong> Wépion, Flawinne, Belgrade, Vedrin, Malonne, Champion.</li>
          <li><strong>Devis transparent :</strong> Estimation préalable par téléphone et chiffrage sur place.</li>
        </ul>
        <a href="/locations" class="btn btn-outline" style="margin-top: 1rem;">Voir toutes les communes couvertes</a>
      </div>
      <div class="map-visual card" style="padding: 0; overflow: hidden; border-radius: var(--radius-xl); min-height: 350px;">
        <GlobalMap />
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="section bg-light" aria-label="Avis clients">
    <div class="container text-center">
      <h2>Avis de clients dans la région de Namur</h2>
      <p style="max-width: 600px; margin: 0 auto 3rem;">Témoignages de particuliers ayant sollicité nos services de dépannage et rénovation.</p>
      
      <div class="grid grid-3 text-left">
        <div class="card">
          <div style="color: #facc15; font-size: 1.25rem; margin-bottom: 0.5rem;" aria-hidden="true">★★★★★</div>
          <p>"Canalisation bouchée un dimanche en fin de journée. Le déboucheur est intervenu avec du matériel adapté et a réglé le problème sans abîmer les tuyaux. Prix convenu respecté."</p>
          <strong>- M. D. (Jambes)</strong>
        </div>
        <div class="card">
          <div style="color: #facc15; font-size: 1.25rem; margin-bottom: 0.5rem;" aria-hidden="true">★★★★★</div>
          <p>"Infiltration invisible sous la baignoire. Localisation rapide avec caméra thermique sans casser le carrelage. Rapport détaillé remis pour le dossier d'assurance."</p>
          <strong>- S. L. (Namur Centre)</strong>
        </div>
        <div class="card">
          <div style="color: #facc15; font-size: 1.25rem; margin-bottom: 0.5rem;" aria-hidden="true">★★★★★</div>
          <p>"Chaudière gaz en sécurité par grand froid. Remplacement de la pièce défectueuse directement depuis le stock du véhicule. Très réactif et professionnel."</p>
          <strong>- T. W. (Erpent)</strong>
        </div>
      </div>
      <div class="mt-4">
        <a href={BUSINESS_CONFIG.googleBusinessProfileUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Voir les avis sur notre fiche Google Business Profile ↗
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (GEO / AEO READINESS) -->
  <section class="section faq-section">
    <div class="container">
      <div class="text-center mb-4">
        <h2>Foire Aux Questions : Plomberie à Namur</h2>
        <p style="max-width: 650px; margin: 0 auto;">Réponses factuelles et directes aux questions les plus courantes sur nos interventions.</p>
      </div>

      <div class="faq-grid" style="max-width: 850px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card">
          <h3>Quel est le prix d'un dépannage plombier à Namur ?</h3>
          <p>
            Le tarif d'une intervention à Namur dépend du type de panne : un débouchage manuel commence à partir de 75€, une recherche de fuite sans casse à partir de 65€, tandis que le curage haute pression ou les dépannages nocturnes font l'objet d'une estimation préalable. Le devis est systématiquement présenté avant le début des travaux.
          </p>
        </div>

        <div class="card">
          <h3>Quand faut-il appeler un plombier en urgence 24/7 ?</h3>
          <p>
            Une intervention d'urgence 24/7 se justifie immédiatement en cas de tuyau percé avec inondation active, de refoulement d'égout dans votre logement, ou de panne totale de chauffage en plein hiver avec des personnes vulnérables. Pour un robinet qui goutte légèrement, une prise de rendez-vous en journée permet d'éviter les majorations de nuit.
          </p>
        </div>

        <div class="card">
          <h3>Comment savoir si une canalisation est bouchée ?</h3>
          <p>
            Les signes annonciateurs sont un écoulement ralenti dans l'évier ou la douche, des bruits d'aspiration (glouglou) dans les canalisations, des mauvaises odeurs persistantes, ou une eau qui remonte dans les toilettes lorsque la chasse est actionnée.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="section cta-section text-center">
    <div class="container">
      <h2>Besoin d'un Dépannage Rapide à Namur ?</h2>
      <p style="font-size: 1.2rem; margin-bottom: 2rem;">Nos artisans plombiers et chauffagistes sont joignables 24h/24 et 7j/7 pour sécuriser votre installation.</p>
      <a href={BUSINESS_CONFIG.telephoneHref} class="btn btn-primary" style="font-size: 1.25rem; padding: 1rem 2rem;" data-location="home_bottom_cta">
        Urgence : {BUSINESS_CONFIG.telephone}
      </a>
    </div>
  </section>

</Layout>

<style>
  .text-secondary {
    color: var(--secondary);
  }
  
  .bg-light {
    background-color: #f1f5f9;
  }
  
  .hero {
    padding: 3.5rem 0 2.5rem;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  
  .hero::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(37,99,235,0.08) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    z-index: -1;
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
    width: 100%;
  }

  .hero-content {
    width: 100%;
  }
  
  .hero-text {
    font-size: 1.125rem;
    margin: 1.25rem 0 2rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .trust-signals {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
  }

  .trust-item {
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .trust-item a {
    color: inherit;
    text-decoration: underline;
    font-size: 0.9rem;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
  }

  .hero-photo {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--radius-xl);
  }
  
  .experience-card {
    position: absolute;
    bottom: -15px;
    left: -15px;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-lg);
  }

  .experience-icon {
    font-size: 1.85rem;
  }

  .experience-card p {
    margin: 0;
    font-size: 0.85rem;
  }
  
  .step-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  
  .service-card {
    text-align: left;
    display: flex;
    flex-direction: column;
  }
  
  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--primary);
  }

  .service-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .service-card p {
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }
  
  .service-link {
    display: inline-block;
    margin-top: auto;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--secondary);
    text-decoration: none;
    transition: transform 0.2s;
  }

  .service-link:hover {
    transform: translateX(4px);
    text-decoration: underline;
  }
  
  .cta-section {
    background: var(--primary);
    color: white;
    padding: 6rem 1rem;
  }
  
  .cta-section h2 {
    color: white;
  }
  
  .cta-section p {
    color: rgba(255,255,255,0.85);
  }
  
  .styled-list {
    list-style: none;
    padding: 0;
  }
  
  .styled-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .styled-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--secondary);
    font-weight: bold;
    font-size: 1.2rem;
  }
  
  .mt-2 { margin-top: 1rem; }
  .mt-4 { margin-top: 2rem; }
  .mb-4 { margin-bottom: 2rem; }
  
  @media (max-width: 900px) {
    .hero {
      padding: 1.75rem 0 2rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-content {
      order: 1;
    }

    .hero-image {
      order: 2;
    }

    .hero-photo {
      height: 260px;
      border-radius: var(--radius-lg);
    }

    .experience-card {
      position: relative;
      bottom: auto;
      left: auto;
      margin-top: -1.25rem;
      margin-left: 0.75rem;
      margin-right: 0.75rem;
    }
  }

  @media (max-width: 768px) {
    .stats-strip .grid-4 {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .cta-section {
      padding: 3.5rem 1rem;
    }
  }

  @media (max-width: 520px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
      text-align: center;
    }

    .trust-signals {
      gap: 1rem;
      justify-content: space-between;
    }

    .trust-item {
      flex: 1 1 45%;
      min-width: 130px;
    }
  }

  @media (max-width: 420px) {
    .stats-strip .grid-4 {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
