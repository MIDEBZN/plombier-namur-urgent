---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCrossLinks from '../../components/ServiceCrossLinks.astro';
import { BUSINESS_CONFIG } from '../../data/business';

const faqs = [
  {
    question: "Comment savoir si une canalisation est bouchée ?",
    answer: "Les premiers signaux d'alerte sont un écoulement inhabituellement lent de l'eau, des gargouillements dans les siphons lors de l'évacuation, des remontées d'odeurs désagréables et une cuvette de WC qui se remplit anormalement. Intervenir dès ces signes évite le débordement complet et les dégâts des eaux."
  },
  {
    question: "Pourquoi éviter les déboucheurs chimiques du commerce ?",
    answer: "Les déboucheurs à base de soude caustique ou d'acide sulfurique sont dangereux pour l'utilisateur, très nocifs pour les cours d'eau (la Sambre et la Meuse), et peuvent déformer les tuyaux en PVC sous l'effet de la chaleur chimique. Un débouchage mécanique ou hydrodynamique est inoffensif pour vos installations et nettement plus efficace."
  },
  {
    question: "Quand faut-il procéder à une inspection caméra ?",
    answer: "L'inspection par caméra endoscopique est recommandée en cas de bouchons récurrents au même endroit, après un emménagement pour inspecter l'égouttage, ou pour détecter d'éventuelles racines d'arbres ayant percé les tuyaux extérieurs."
  }
];
---

<Layout 
  title="Débouchage Canalisation & WC Namur | Curage Haute Pression 24/7" 
  description="Service de débouchage de canalisation à Namur. WC bouché, évier, égout refoulant. Curage haute pression et inspection caméra endoscopique. Intervention rapide."
  schemaType="service"
  serviceName="Débouchage Canalisation et WC à Namur"
  faq={faqs}
>
  <Breadcrumbs items={[
    { name: "Services", url: "/services" },
    { name: "Débouchage Canalisation" }
  ]} />

  <div class="page-header text-center">
    <div class="container">
      <span class="badge badge-red mb-2">Intervention Rapide 24/7</span>
      <h1>Débouchage Canalisation & WC à Namur</h1>
      <p class="subtitle">Finis les refoulements d'eau et les mauvaises odeurs. Nos déboucheurs professionnels éliminent les bouchons tenaces par furet mécanique, hydrocurage haute pression et caméra d'inspection.</p>
      <div class="mt-4">
        <a href={BUSINESS_CONFIG.telephoneHref} class="btn btn-primary" style="font-size: 1.25rem; padding: 0.9rem 2rem;" data-location="debouchage_header_phone">
          📞 Demander un Débouchage : {BUSINESS_CONFIG.telephone}
        </a>
      </div>
    </div>
  </div>

  <div class="container section">
    
    <!-- What's included & Common Problems -->
    <div class="grid grid-2 mb-4">
      <div class="card">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary);">Ce qui est inclus dans notre prestation de débouchage</h2>
        <ul class="styled-list">
          <li><strong>Diagnostic immédiat :</strong> Identification de l'emplacement du bouchon (siphon, colonne ou égout).</li>
          <li><strong>Débouchage mécanique :</strong> Furet rotatif professionnel pour les engorgements domestiques.</li>
          <li><strong>Hydrocurage haute pression :</strong> Nettoyage complet des parois par jet d'eau jusqu'à 200 bars.</li>
          <li><strong>Inspection caméra vidéo :</strong> Vérification de l'état structurel des tuyaux (fissures, racines, affaissements).</li>
          <li><strong>Test d'écoulement :</strong> Contrôle de l'évacuation normale des eaux usées avant départ.</li>
        </ul>
      </div>
      
      <div class="card bg-light border-0">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--secondary);">Situations Traitées à Namur</h2>
        <ul class="styled-list">
          <li><strong>WC et toilettes bouchées :</strong> Niveau d'eau qui monte dangereusement à chaque chasse.</li>
          <li><strong>Évier de cuisine engorgé :</strong> Amas de graisses alimentaires et résidus de vaisselle solidifiés.</li>
          <li><strong>Douche et baignoire qui débordent :</strong> Amas de cheveux et résidus savonneux dans la bonde.</li>
          <li><strong>Refoulement d'égout en sous-sol :</strong> Inondation d'eaux usées nécessitant un curage immédiat.</li>
          <li><strong>Mauvaises odeurs d'égout :</strong> Problème de ventilation primaire ou siphon désamorcé.</li>
        </ul>
      </div>
    </div>

    <!-- Process -->
    <div class="mb-4">
      <h2 class="text-center mb-4">Notre Méthode de Débouchage Professionnel</h2>
      <div class="grid grid-4 text-center">
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">1</div>
          <h3>Localisation</h3>
          <p>Identification du regard de visite ou de la colonne obstruée.</p>
        </div>
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">2</div>
          <h3>Dégagement</h3>
          <p>Passage du furet ou buse haute pression pour détruire le bouchon.</p>
        </div>
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">3</div>
          <h3>Curage</h3>
          <p>Lessivage des parois internes pour éviter toute récidive rapide.</p>
        </div>
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">4</div>
          <h3>Contrôle Vidéo</h3>
          <p>Passage caméra si nécessaire pour vérifier l'intégrité de la conduite.</p>
        </div>
      </div>
    </div>

    <!-- Direct Answer Block & FAQs -->
    <div class="faq-section mt-4 card">
      <h2 class="text-center mb-4">Questions Fréquentes sur le Débouchage à Namur</h2>
      
      <div class="faq-list" style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="faq-item">
          <h3 style="color: var(--primary); font-size: 1.2rem; margin-bottom: 0.5rem;">Comment savoir si une canalisation est bouchée ?</h3>
          <p style="margin: 0; line-height: 1.6;">
            Les premiers signaux d'alerte sont un écoulement inhabituellement lent de l'eau, des gargouillements dans les siphons lors de l'évacuation, des remontées d'odeurs désagréables et une cuvette de WC qui se remplit anormalement. Intervenir dès ces signes évite le débordement complet et les dégâts des eaux.
          </p>
        </div>

        <div class="faq-item">
          <h3 style="color: var(--primary); font-size: 1.2rem; margin-bottom: 0.5rem;">Pourquoi éviter les déboucheurs chimiques du commerce ?</h3>
          <p style="margin: 0; line-height: 1.6;">
            Les déboucheurs à base de soude caustique ou d'acide sulfurique sont dangereux pour l'utilisateur, très nocifs pour les cours d'eau (la Sambre et la Meuse), et peuvent déformer les tuyaux en PVC sous l'effet de la chaleur chimique. Un débouchage mécanique ou hydrodynamique est inoffensif pour vos installations et nettement plus efficace.
          </p>
        </div>

        <div class="faq-item">
          <h3 style="color: var(--primary); font-size: 1.2rem; margin-bottom: 0.5rem;">Quand faut-il procéder à une inspection caméra ?</h3>
          <p style="margin: 0; line-height: 1.6;">
            L'inspection par caméra endoscopique est recommandée en cas de bouchons récurrents au même endroit, après un emménagement pour inspecter l'égouttage, ou pour détecter d'éventuelles racines d'arbres ayant percé les tuyaux extérieurs.
          </p>
        </div>
      </div>
    </div>

    <!-- Contextual Cross-links & Local Siloing -->
    <ServiceCrossLinks currentService="debouchage" />

    <div class="card mt-4 p-4" style="background: var(--bg-light);">
      <h2>Autres Dépannages Complémentaires</h2>
      <div class="grid grid-3 mt-2" style="gap: 1rem;">
        <a href="/services/urgence" class="btn btn-outline" style="text-align: center;">
          🚨 Dépannage Urgent 24/7
        </a>
        <a href="/services/fuites" class="btn btn-outline" style="text-align: center;">
          💧 Recherche de Fuite Sans Casse
        </a>
        <a href="/services/chauffage" class="btn btn-outline" style="text-align: center;">
          🔥 Chauffage & Chaudières
        </a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .page-header {
    background-color: var(--primary);
    color: white;
    padding: 5rem 1rem 3.5rem;
  }
  
  .page-header h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 2.2rem;
  }
  
  .subtitle {
    color: rgba(255,255,255,0.85);
    font-size: 1.15rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .step-number {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--secondary);
    margin-bottom: 0.5rem;
  }

  .styled-list {
    list-style: none;
    padding: 0;
  }
  
  .styled-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }
  
  .styled-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--secondary);
    font-weight: bold;
    font-size: 1.2rem;
  }

  .faq-list .faq-item {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 1.25rem;
  }

  .faq-list .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mb-2 { margin-bottom: 0.5rem; }
  .mb-4 { margin-bottom: 2.5rem; }
  .mt-2 { margin-top: 1rem; }
  .mt-4 { margin-top: 2.5rem; }
  .bg-light { background-color: var(--bg-light); }
  .border-0 { border: none; box-shadow: none; }
</style>
