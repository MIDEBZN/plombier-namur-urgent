---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCrossLinks from '../../components/ServiceCrossLinks.astro';
import { BUSINESS_CONFIG } from '../../data/business';

const faqs = [
  {
    question: "Quelle est la dureté de l'eau dans la région de Namur ?",
    answer: "L'eau potable distribuée par la SWDE et l'INASEP dans le Grand Namur provient en grande partie des nappes calcaires du sous-sol condrusien et hesbignon. Sa dureté oscille généralement entre 28 et 35 degrés français (°f), ce qui la classe dans la catégorie des eaux « très dures ». Un adoucisseur est vivement recommandé dès 25 °f."
  },
  {
    question: "Peut-on boire de l'eau adoucie au sel ?",
    answer: "Oui, une eau adoucie reste potable et conforme aux normes sanitaires belges tant que la dureté n'est pas réglée à 0 °f (nous calibrons la dureté résiduelle entre 7 et 10 °f). L'apport en sodium reste minime (comparable à celui d'une tranche de pain par litre). Pour les personnes suivant un régime strictement sans sel ou pour la préparation des biberons, nous pouvons raccorder un robinet d'eau brute non adoucie en cuisine."
  },
  {
    question: "Quel est le coût d'entretien annuel d'un adoucisseur ?",
    answer: "Pour un foyer de 4 personnes, la consommation moyenne de sel régénérant est d'environ 100 à 150 kg par an (soit environ 40 à 60€ de consommables). La visite d'entretien annuelle comprend le nettoyage du bac à sel, la désinfection des résines et le contrôle des paramètres de la vanne volumétrique."
  }
];
---

<Layout 
  title="Adoucisseur d'Eau Namur | Installation & Entretien Anti-Calcaire" 
  description="Installation d'adoucisseurs d'eau à Namur. Protection contre le calcaire et l'eau dure (30 °f). Entretien, sel régénérant et filtration. Devis gratuit."
  schemaType="service"
  serviceName="Traitement de l'Eau et Adoucisseurs à Namur"
  faq={faqs}
>
  <Breadcrumbs items={[
    { name: "Services", url: "/services" },
    { name: "Traitement de l'Eau" }
  ]} />

  <div class="page-header text-center">
    <div class="container">
      <span class="badge badge-red mb-2">Protection Anti-Calcaire Namurois</span>
      <h1>Traitement de l'Eau & Adoucisseurs à Namur</h1>
      <p class="subtitle">L'eau distribuée dans le bassin namurois est particulièrement calcaire (28 à 32 °f). Protégez votre plomberie, vos appareils ménagers et votre peau avec un système d'adoucissement adapté.</p>
      <div class="mt-4">
        <a href="/contact" class="btn btn-primary" style="font-size: 1.25rem; padding: 0.9rem 2rem;">
          Demander un Devis Adoucisseur
        </a>
      </div>
    </div>
  </div>

  <div class="container section">
    
    <!-- Solutions & Risks -->
    <div class="grid grid-2 mb-4">
      <div class="card">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary);">Nos Solutions de Traitement de l'Eau</h2>
        <ul class="styled-list">
          <li><strong>Adoucisseurs volumétriques à sel :</strong> Échange d'ions sodium contre calcium/magnésium avec régénération automatique économique en eau et sel.</li>
          <li><strong>Adoucisseurs au CO2 :</strong> Injection de CO2 alimentaire qui transforme le carbonate de calcium en bicarbonate soluble, sans sel ni gaspillage d'eau.</li>
          <li><strong>Filtration sous évier & purificateurs :</strong> Filtres à charbon actif et sédiments pour éliminer le goût de chlore et les micro-particules.</li>
          <li><strong>Entretien & révision périodique :</strong> Nettoyage des résines, désinfection, contrôle de la dureté résiduelle et fourniture de sel purifié.</li>
          <li><strong>Installation avec Bypass :</strong> Vanne de dérivation permettant de conserver de l'eau non adoucie pour le jardin ou en cas d'intervention.</li>
        </ul>
      </div>
      
      <div class="card bg-light border-0">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--secondary);">Conséquences d'une Eau Dure à Namur</h2>
        <ul class="styled-list">
          <li><strong>Surconsommation électrique :</strong> 1 mm de calcaire sur la résistance d'un boiler entraîne 10% de consommation d'énergie supplémentaire.</li>
          <li><strong>Panne prématurée des appareils :</strong> Lave-linge, lave-vaisselle et échangeurs de chaudière s'entartrent en moins de 3 à 5 ans.</li>
          <li><strong>Robinetteries entartrées :</strong> Traces blanches incrustées sur les parois de douche, aérateurs bouchés et mitigeurs bloqués.</li>
          <li><strong>Inconfort dermatologique :</strong> Tiraillements de la peau, démangeaisons et cheveux ternes après la douche.</li>
          <li><strong>Budget produits ménagers :</strong> Surutilisation de détergents, anticalcaires acides et adoucissants textiles.</li>
        </ul>
      </div>
    </div>

    <!-- Installation Steps -->
    <div class="mb-4">
      <h2 class="text-center mb-4">Notre Protocole d'Installation d'Adoucisseur</h2>
      <div class="grid grid-4 text-center">
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">1</div>
          <h3>Test de Dureté</h3>
          <p>Mesure sur place du titre hydrotimétrique (°f) à votre robinet pour évaluer la teneur en calcaire.</p>
        </div>
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">2</div>
          <h3>Dimensionnement</h3>
          <p>Calcul du volume de résine nécessaire selon le nombre d'occupants et votre consommation annuelle.</p>
        </div>
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">3</div>
          <h3>Raccordement</h3>
          <p>Pose après compteur avec filtre sédiment, clapet anti-retour, bypass et évacuation de saumure.</p>
        </div>
        <div class="process-step card">
          <div class="step-number" aria-hidden="true">4</div>
          <h3>Mise en Service</h3>
          <p>Programmation de la vanne électronique, réglage du mélangeur et test de l'eau adoucie (cible : 7-10 °f).</p>
        </div>
      </div>
    </div>

    <!-- Direct Answer Block & FAQs -->
    <div class="faq-section mt-4 card">
      <h2 class="text-center mb-4">Questions Fréquentes : Adoucisseurs d'Eau à Namur</h2>
      
      <div class="faq-list" style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="faq-item">
          <h3 style="color: var(--primary); font-size: 1.2rem; margin-bottom: 0.5rem;">Quelle est la dureté de l'eau dans la région de Namur ?</h3>
          <p style="margin: 0; line-height: 1.6;">
            L'eau potable distribuée par la SWDE et l'INASEP dans le Grand Namur provient en grande partie des nappes calcaires du sous-sol condrusien et hesbignon. Sa dureté oscille généralement entre 28 et 35 degrés français (°f), ce qui la classe dans la catégorie des eaux « très dures ». Un adoucisseur est vivement recommandé dès 25 °f.
          </p>
        </div>

        <div class="faq-item">
          <h3 style="color: var(--primary); font-size: 1.2rem; margin-bottom: 0.5rem;">Peut-on boire de l'eau adoucie au sel ?</h3>
          <p style="margin: 0; line-height: 1.6;">
            Oui, une eau adoucie reste potable et conforme aux normes sanitaires belges tant que la dureté n'est pas réglée à 0 °f (nous calibrons la dureté résiduelle entre 7 et 10 °f). L'apport en sodium reste minime (comparable à celui d'une tranche de pain par litre). Pour les personnes suivant un régime strictement sans sel ou pour la préparation des biberons, nous pouvons raccorder un robinet d'eau brute non adoucie en cuisine.
          </p>
        </div>

        <div class="faq-item">
          <h3 style="color: var(--primary); font-size: 1.2rem; margin-bottom: 0.5rem;">Quel est le coût d'entretien annuel d'un adoucisseur ?</h3>
          <p style="margin: 0; line-height: 1.6;">
            Pour un foyer de 4 personnes, la consommation moyenne de sel régénérant est d'environ 100 à 150 kg par an (soit environ 40 à 60€ de consommables). La visite d'entretien annuelle comprend le nettoyage du bac à sel, la désinfection des résines et le contrôle des paramètres de la vanne volumétrique.
          </p>
        </div>
      </div>
    </div>

    <!-- Contextual Links & Local Siloing -->
    <ServiceCrossLinks currentService="traitement-eau" />

    <div class="card mt-4 p-4" style="background: var(--bg-light);">
      <h2>Protéger vos autres installations</h2>
      <div class="grid grid-3 mt-2" style="gap: 1rem;">
        <a href="/services/chauffage" class="btn btn-outline" style="text-align: center;">
          🔥 Protéger votre Chaudière
        </a>
        <a href="/services/sanitaire" class="btn btn-outline" style="text-align: center;">
          🚿 Rénovation Salle de Bain
        </a>
        <a href="/services/fuites" class="btn btn-outline" style="text-align: center;">
          💧 Détection Fuite Sans Casse
        </a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .page-header {
    background-color: var(--primary);
    color: white;
    padding: 5rem 1rem 3.5rem;
  }
  
  .page-header h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 2.2rem;
  }
  
  .subtitle {
    color: rgba(255,255,255,0.85);
    font-size: 1.15rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .step-number {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--secondary);
    margin-bottom: 0.5rem;
  }

  .styled-list {
    list-style: none;
    padding: 0;
  }
  
  .styled-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }
  
  .styled-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--secondary);
    font-weight: bold;
    font-size: 1.2rem;
  }

  .faq-list .faq-item {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 1.25rem;
  }

  .faq-list .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mb-2 { margin-bottom: 0.5rem; }
  .mb-4 { margin-bottom: 2.5rem; }
  .mt-2 { margin-top: 1rem; }
  .mt-4 { margin-top: 2.5rem; }
  .bg-light { background-color: var(--bg-light); }
  .border-0 { border: none; box-shadow: none; }
</style>
