---
import { BUSINESS_CONFIG } from '../data/business';

interface Props {
  type?: 'home' | 'service' | 'article' | 'location' | 'default';
  title?: string;
  description?: string;
  serviceName?: string;
  areaServedName?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
}

const {
  type = 'default',
  title = BUSINESS_CONFIG.businessName,
  description = "Entreprise de plomberie et chauffage à Namur. Dépannage urgent 24/7, débouchage et recherche de fuite.",
  serviceName,
  areaServedName,
  datePublished,
  dateModified,
  authorName
} = Astro.props;

const siteUrl = BUSINESS_CONFIG.mainBusinessUrl;
const businessId = `${siteUrl}#business`;
const websiteId = `${siteUrl}#website`;
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteUrl).href;

const baseBusiness = {
  "@type": "PlumbingService",
  "@id": businessId,
  "name": BUSINESS_CONFIG.businessName,
  "legalName": BUSINESS_CONFIG.legalBusinessName,
  "url": siteUrl,
  "logo": BUSINESS_CONFIG.logoUrl,
  "image": `${siteUrl}/hero.jpg`,
  "telephone": BUSINESS_CONFIG.telephoneE164,
  "email": BUSINESS_CONFIG.email,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": BUSINESS_CONFIG.streetAddress,
    "postalCode": BUSINESS_CONFIG.postalCode,
    "addressLocality": BUSINESS_CONFIG.city,
    "addressRegion": BUSINESS_CONFIG.addressRegion,
    "addressCountry": BUSINESS_CONFIG.country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.46938,
    "longitude": 4.88035
  },
  "openingHoursSpecification": BUSINESS_CONFIG.openingHoursSpecification.map(spec => ({
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": spec.dayOfWeek,
    "opens": spec.opens,
    "closes": spec.closes
  })),
  "areaServed": BUSINESS_CONFIG.serviceAreas.map(area => ({
    "@type": "AdministrativeArea",
    "name": area
  })),
  "sameAs": [
    BUSINESS_CONFIG.googleBusinessProfileUrl
  ].filter(Boolean)
};

const graph: any[] = [];

if (type === 'home') {
  graph.push(
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": siteUrl,
      "name": BUSINESS_CONFIG.businessName,
      "inLanguage": "fr-BE",
      "publisher": { "@id": businessId }
    },
    baseBusiness
  );
} else if (type === 'service') {
  graph.push(
    baseBusiness,
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": serviceName || title,
      "description": description,
      "provider": { "@id": businessId },
      "serviceType": "Dépannage plomberie et chauffage",
      "areaServed": BUSINESS_CONFIG.serviceAreas.map(area => ({
        "@type": "AdministrativeArea",
        "name": area
      }))
    }
  );
} else if (type === 'article') {
  graph.push(
    baseBusiness,
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": title,
      "description": description,
      "mainEntityOfPage": canonicalUrl,
      "inLanguage": "fr-BE",
      "author": {
        "@type": "Organization",
        "name": authorName || BUSINESS_CONFIG.businessName,
        "url": siteUrl
      },
      "publisher": { "@id": businessId },
      "datePublished": datePublished || "2025-01-15T08:00:00+01:00",
      "dateModified": dateModified || "2026-09-13T10:00:00+02:00"
    }
  );
} else if (type === 'location') {
  graph.push(
    baseBusiness,
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "name": title,
      "description": description,
      "url": canonicalUrl,
      "inLanguage": "fr-BE",
      "about": { "@id": businessId },
      "mainEntity": {
        "@type": "Service",
        "name": `Dépannage plomberie à ${areaServedName || 'Namur'}`,
        "provider": { "@id": businessId },
        "areaServed": {
          "@type": "AdministrativeArea",
          "name": areaServedName || "Namur"
        }
      }
    }
  );
} else {
  graph.push(
    baseBusiness,
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "inLanguage": "fr-BE",
      "isPartOf": { "@id": websiteId }
    }
  );
}

const schemaData = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
