---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
import { BUSINESS_CONFIG } from '../data/business';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid grid-4 footer-content">
    
    <div class="footer-col">
      <div class="logo" style="margin-bottom: 1.5rem;">
        <Image src={logoImage} alt="Logo Plombier Namur Urgent" width={300} height={300} style="width: auto; height: 100px; object-fit: contain;" />
      </div>
      <p class="company-desc">
        Dépannage d'urgence, débouchage de canalisation, recherche de fuite non destructive et entretien chauffage à Namur. Devis transparent avant intervention.
      </p>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Services</h3>
      <ul>
        <li><a href="/services/urgence">Dépannage Urgent 24/7</a></li>
        <li><a href="/services/debouchage">Débouchage Canalisation</a></li>
        <li><a href="/services/fuites">Recherche de Fuite Sans Casse</a></li>
        <li><a href="/services/chauffage">Chauffage & Chaudières</a></li>
        <li><a href="/services/sanitaire">Installations Sanitaires</a></li>
        <li><a href="/services/traitement-eau">Traitement de l'Eau & Adoucisseurs</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Navigation Rapide</h3>
      <ul>
        <li><a href="/services">Tous nos Services</a></li>
        <li><a href="/locations">Zones d'Intervention (Grand Namur)</a></li>
        <li><a href="/conseils">Guides & Conseils Plomberie</a></li>
        <li><a href="/about">À Propos de l'Entreprise</a></li>
        <li><a href="/contact">Contact & Devis Gratuit</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Contactez-nous</h3>
      <ul class="contact-list">
        <li><strong>Adresse:</strong> <a href={BUSINESS_CONFIG.googleBusinessProfileUrl} target="_blank" rel="noopener noreferrer">{BUSINESS_CONFIG.streetAddress}, {BUSINESS_CONFIG.postalCode} {BUSINESS_CONFIG.city}</a></li>
        <li><strong>Téléphone:</strong> <a href={BUSINESS_CONFIG.telephoneHref} data-location="footer_phone">{BUSINESS_CONFIG.telephone}</a></li>
        <li><strong>Email:</strong> <a href={`mailto:${BUSINESS_CONFIG.email}`}>{BUSINESS_CONFIG.email}</a></li>
        <li><strong>Permanence:</strong> {BUSINESS_CONFIG.businessHours}</li>
      </ul>
    </div>

  </div>
  
  <div class="footer-bottom">
    <div class="container flex-between">
      <p>&copy; {year} {BUSINESS_CONFIG.businessName}. Tous droits réservés.</p>
      <div class="legal-links">
        <a href="/mentions-legales">Mentions Légales</a>
        <a href="/politique-de-confidentialite">Politique de Confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--primary);
    color: rgba(255,255,255,0.8);
    margin-top: 4rem;
  }
  
  .footer-content {
    padding: 5rem 1rem;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  
  .logo-icon {
    font-size: 2.5rem;
    line-height: 1;
  }
  
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  
  .logo-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1;
  }
  
  .logo-subtitle {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .company-desc {
    color: rgba(255,255,255,0.7);
    font-size: 0.95rem;
  }
  
  .footer-heading {
    color: white;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    position: relative;
    padding-bottom: 0.5rem;
  }
  
  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background-color: var(--secondary);
    border-radius: 2px;
  }
  
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .footer-col a {
    color: rgba(255,255,255,0.7);
    transition: color 0.3s;
  }
  
  .footer-col a:hover {
    color: var(--secondary);
    padding-left: 5px;
  }
  
  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .contact-list strong {
    color: white;
  }
  
  .footer-bottom {
    background-color: #081635; /* Darker navy */
    padding: 1.5rem 0;
    font-size: 0.9rem;
  }
  
  .legal-links {
    display: flex;
    gap: 1.5rem;
  }
  
  @media (max-width: 768px) {
    .footer-bottom .flex-between {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
