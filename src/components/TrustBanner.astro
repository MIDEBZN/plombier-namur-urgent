---
// TrustBanner.astro
---

<div class="trust-banner">
  <div class="container">
    <div class="trust-grid">
      
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">🛡️</span>
        <div>
          <h4>Dossiers Assurances</h4>
          <p>Rapports et devis conformes aux exigences d'assurance</p>
        </div>
      </div>
      
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">🏆</span>
        <div>
          <h4>Expertise Métier</h4>
          <p>Techniciens expérimentés dans tout le Grand Namur</p>
        </div>
      </div>
      
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">📜</span>
        <div>
          <h4>Normes & Sécurité</h4>
          <p>Respect des normes belges NBN et habilitations gaz</p>
        </div>
      </div>
      
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">✅</span>
        <div>
          <h4>Devis Avant Travaux</h4>
          <p>Tarification transparente sans frais cachés</p>
        </div>
      </div>
      
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">⏱️</span>
        <div>
          <h4>Permanence 24/7</h4>
          <p>Intervention rapide selon disponibilité et trafic</p>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .trust-banner {
    background-color: var(--primary);
    color: white;
    padding: 2rem 0;
    margin-top: 4rem;
    border-top: 4px solid var(--secondary);
  }
  
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }
  
  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .trust-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .trust-item h4 {
    color: white;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }
  
  .trust-item p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.8);
    margin: 0;
  }
  
  @media (max-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 2rem;
    }
  }
  
  @media (max-width: 600px) {
    .trust-grid {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }
    
    .trust-item {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .trust-icon {
      margin-bottom: 0;
    }
  }
</style>
