---
// GlobalContactForm.astro
---

<div class="global-contact-section section" id="devis">
  <div class="container">
    <div class="grid grid-2" style="align-items: center;">
      <div class="contact-text">
        <span class="badge badge-red mb-2">Devis Gratuit & Rapide</span>
        <h2>Besoin d'un Plombier à Namur ?</h2>
        <p>Remplissez ce formulaire pour obtenir un devis gratuit ou planifier une intervention. Nous vous rappelons dans les plus brefs délais !</p>
        <ul class="styled-list mt-4">
          <li>Réponse rapide garantie</li>
          <li>Devis 100% transparent avant travaux</li>
          <li>Urgence traitée en priorité</li>
        </ul>
      </div>
      
      <div class="form-card card">
        <form action="https://formsubmit.co/midebzn@gmail.com" method="POST" class="contact-form">
          <!-- Honeypot -->
          <input type="text" name="_honey" style="display:none">
          <!-- Disable Captcha -->
          <input type="hidden" name="_captcha" value="false">
          <!-- Success URL (Optional, but good practice to keep them on site) -->
          <!-- <input type="hidden" name="_next" value="https://plombier-namur-urgent.be/merci"> -->
          
          <div class="form-group">
            <label for="g-name">Nom complet *</label>
            <input type="text" id="g-name" name="name" required placeholder="Votre nom" />
          </div>
          
          <div class="form-group">
            <label for="g-phone">Téléphone *</label>
            <input type="tel" id="g-phone" name="phone" required placeholder="04xx xx xx xx" />
          </div>
          
          <div class="form-group">
            <label for="g-service">Type d'intervention</label>
            <select id="g-service" name="service">
              <option value="urgence">Urgence / Fuite</option>
              <option value="debouchage">Débouchage</option>
              <option value="chauffage">Chauffage / Chaudière</option>
              <option value="sanitaire">Installation Sanitaire</option>
              <option value="autre">Autre demande</option>
            </select>
          </div>
          
          <button type="submit" class="btn btn-primary" style="width: 100%;">Envoyer la demande</button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .global-contact-section {
    background-color: var(--bg-light);
    border-top: 1px solid var(--border-light);
    padding: 5rem 0;
  }
  
  .contact-text h2 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }
  
  .contact-text p {
    font-size: 1.1rem;
    color: var(--text-muted);
  }
  
  .form-card {
    background-color: white;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  
  .form-group {
    margin-bottom: 1.5rem;
  }
  
  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--primary);
  }
  
  .form-group input,
  .form-group select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.3s;
  }
  
  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--secondary);
  }
  
  .styled-list {
    list-style: none;
    padding: 0;
  }
  
  .styled-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .styled-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--secondary);
    font-weight: bold;
    font-size: 1.2rem;
  }
  
  .mb-2 { margin-bottom: 1rem; }
  .mt-4 { margin-top: 2rem; }
  
  @media (max-width: 768px) {
    .grid-2 {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
  }
</style>
