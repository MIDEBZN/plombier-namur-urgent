---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BUSINESS_CONFIG } from '../data/business';

const { frontmatter } = Astro.props;

const author = frontmatter.author || "Équipe technique Plombier Namur Urgent";
const authorRole = frontmatter.authorRole || "Plombier-Chauffagiste certifié";
const datePublished = frontmatter.datePublished || "2025-02-01";
const dateModified = frontmatter.dateModified || "2026-09-13";
const reviewer = frontmatter.reviewer || "Revu par l'équipe technique - Conformité réglementaire Wallonie";
---

<Layout 
  title={frontmatter.title} 
  description={frontmatter.meta_description}
  schemaType="article"
  authorName={author}
  datePublished={`${datePublished}T08:00:00+01:00`}
  dateModified={`${dateModified}T10:00:00+02:00`}
>
  <Breadcrumbs items={[
    { name: "Conseils", url: "/conseils" },
    { name: frontmatter.title }
  ]} />

  <div class="blog-header bg-primary">
    <div class="container text-center">
      <h1>{frontmatter.title}</h1>
      <div class="article-meta">
        <span>✍️ {author} ({authorRole})</span>
        <span class="meta-divider">•</span>
        <span>📅 Mis à jour le {dateModified}</span>
        <span class="meta-divider">•</span>
        <span>🛡️ {reviewer}</span>
      </div>
    </div>
  </div>

  <div class="container blog-container">
    <article class="blog-content">
      <slot />

      <!-- Author & Technical Reviewer Bio Card (E-E-A-T) -->
      <div class="author-bio-card card mt-4">
        <div class="author-bio-header">
          <div class="author-avatar" aria-hidden="true">👨‍🔧</div>
          <div>
            <span class="author-label">Auteur &amp; Référent Technique</span>
            <h4 class="author-name">{author}</h4>
            <div class="author-subtitle">{authorRole} • Service Dépannage Grand Namur</div>
          </div>
        </div>
        <p class="author-bio-text">
          Artisan professionnel en plomberie sanitaire, recherche de fuite sans casse et dépannage de chaudière dans l'agglomération namuroise. Les méthodologies d'intervention et estimations tarifaires détaillées dans cet article sont vérifiées conformément aux réglementations de la Région Wallonne (SPW Énergie, normes NBN) et validées pour l'instruction des dossiers d'assurance habitation belges.
        </p>
        <div class="author-badges">
          <span class="badge-item">✓ Agréé Dépannage Gaz &amp; Mazout Wallonie</span>
          <span class="badge-item">✓ Équipements de diagnostic non destructif certifiés</span>
          <span class="badge-item">✓ {reviewer}</span>
        </div>
      </div>

      <!-- Interconnected guides section -->
      <div class="article-related-guides card mt-4 bg-light border-0">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 1rem;">Guides Pratiques Liés</h3>
        <ul class="styled-guides-list">
          <li><a href="/conseils/combien-coute-un-plombier-namur-2026">Combien coûte un plombier à Namur en 2026 ? Le guide complet des tarifs et urgences</a></li>
          <li><a href="/conseils/combien-coute-debouchage-canalisation-namur">Prix débouchage canalisation et WC à Namur : solutions et délais</a></li>
          <li><a href="/conseils/assurance-habitation-rembourse-recherche-fuite-plombier-namur">L'assurance habitation rembourse-t-elle la recherche de fuite d'eau ?</a></li>
          <li><a href="/conseils/combien-coute-recherche-fuite-invisible-namur">Tarifs et méthode de recherche de fuite sans casse à Namur</a></li>
          <li><a href="/conseils/eau-calcaire-namur-adoucisseur-combien-ca-coute">Eau calcaire à Namur : adoucisseur et protection de votre plomberie</a></li>
        </ul>
      </div>
    </article>
    
    <aside class="blog-sidebar" aria-label="Informations et services associés">
      <div class="sidebar-card">
        <h3>Besoin d'un dépannage immédiat ?</h3>
        <p>Nos plombiers et chauffagistes interviennent 24/7 dans tout le Grand Namur.</p>
        <a href={BUSINESS_CONFIG.telephoneHref} class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 1rem;" data-location="article_sidebar_cta">
          <span aria-hidden="true">📞</span> {BUSINESS_CONFIG.telephone}
        </a>
      </div>

      <div class="sidebar-card">
        <h3>Services Associés</h3>
        <ul class="sidebar-links">
          <li><a href="/services/urgence">🚨 Dépannage Urgent 24/7</a></li>
          <li><a href="/services/debouchage">🚽 Débouchage Canalisation</a></li>
          <li><a href="/services/fuites">💧 Détection Fuites Sans Casse</a></li>
          <li><a href="/services/chauffage">🔥 Chauffage & Chaudières</a></li>
          <li><a href="/services/sanitaire">🚿 Installations Sanitaires</a></li>
          <li><a href="/services/traitement-eau">🧊 Adoucisseurs d'Eau</a></li>
        </ul>
      </div>

      <div class="sidebar-card">
        <h3>Zones Desservies à Namur</h3>
        <p style="font-size: 0.9rem; margin-bottom: 0.75rem; color: var(--text-muted);">Permanence 24/7 dans votre commune :</p>
        <ul class="sidebar-links">
          <li><a href="/locations/jambes">Plombier Jambes (5100)</a></li>
          <li><a href="/locations/salzinnes">Plombier Salzinnes (5000)</a></li>
          <li><a href="/locations/bouge">Plombier Bouge (5004)</a></li>
          <li><a href="/locations/erpent">Plombier Erpent (5101)</a></li>
          <li><a href="/locations/saint-servais">Plombier Saint-Servais (5002)</a></li>
          <li><a href="/locations/wepion">Plombier Wépion (5100)</a></li>
          <li><a href="/locations" style="font-weight: 600; color: var(--secondary);">Toutes les communes &rarr;</a></li>
        </ul>
      </div>

      <div class="sidebar-card">
        <h3>Références & Organismes</h3>
        <ul class="sidebar-links external-links">
          <li>
            <a href="https://energie.wallonie.be" target="_blank" rel="noopener noreferrer">
              SPW Énergie (Wallonie) ↗
            </a>
          </li>
          <li>
            <a href="https://www.swde.be" target="_blank" rel="noopener noreferrer">
              SWDE (Distribution d'eau) ↗
            </a>
          </li>
          <li>
            <a href="https://www.inasep.be" target="_blank" rel="noopener noreferrer">
              INASEP (Assainissement Namur) ↗
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .blog-header {
    background-color: var(--primary);
    color: white;
    padding: 3.5rem 1rem 3rem;
    margin-bottom: 2.5rem;
  }
  
  .blog-header h1 {
    font-size: 2.2rem;
    line-height: 1.3;
    margin: 0 0 1rem;
    max-width: 900px;
    margin-inline: auto;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .meta-divider {
    opacity: 0.5;
  }
  
  .blog-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }
  
  /* Markdown Styling */
  .blog-content {
    color: var(--text-main);
    line-height: 1.8;
    font-size: 1.05rem;
  }
  
  .blog-content h2, .blog-content h3 {
    color: var(--primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  
  .blog-content h2 {
    font-size: 1.6rem;
    border-bottom: 2px solid var(--secondary);
    padding-bottom: 0.4rem;
  }

  .blog-content h3 {
    font-size: 1.25rem;
  }
  
  .blog-content p {
    margin-bottom: 1.25rem;
  }
  
  .blog-content ul, .blog-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  
  .blog-content li {
    margin-bottom: 0.5rem;
  }
  
  .blog-content blockquote {
    border-left: 4px solid var(--secondary);
    background: var(--bg-light, #f8fafc);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  
  .blog-content hr {
    border: 0;
    height: 1px;
    background: var(--border-light, #e2e8f0);
    margin: 2.5rem 0;
  }
  
  .sidebar-card {
    background: var(--bg-light, #f8fafc);
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light, #e2e8f0);
    margin-bottom: 1.75rem;
  }
  
  .sidebar-card h3 {
    color: var(--primary);
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  
  .sidebar-links a {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }
  
  .sidebar-links a:hover {
    color: var(--secondary);
    text-decoration: underline;
  }

  .external-links a {
    color: var(--primary);
    font-size: 0.95rem;
  }

  /* E-E-A-T Author Bio Card Styling */
  .author-bio-card {
    background: #f8fafc;
    border: 1px solid var(--border-light, #e2e8f0);
    border-left: 4px solid var(--primary, #0f2b5c);
    padding: 1.75rem;
    border-radius: var(--radius-lg, 0.75rem);
    margin-top: 2.5rem;
  }

  .author-bio-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .author-avatar {
    font-size: 2.5rem;
    line-height: 1;
    background: white;
    padding: 0.5rem;
    border-radius: 50%;
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.05));
    border: 1px solid var(--border-light, #e2e8f0);
  }

  .author-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--secondary, #e01933);
    margin-bottom: 0.2rem;
  }

  .author-name {
    color: var(--primary, #0f2b5c);
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.2;
  }

  .author-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted, #64748b);
    margin-top: 0.25rem;
  }

  .author-bio-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-main, #1e293b);
    margin-bottom: 1rem;
  }

  .author-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge-item {
    font-size: 0.8rem;
    background: white;
    color: var(--primary, #0f2b5c);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-md, 0.375rem);
    border: 1px solid #cbd5e1;
    font-weight: 500;
  }
  
  @media (max-width: 900px) {
    .blog-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .blog-header {
      padding: 2.5rem 1rem;
    }
    .blog-header h1 {
      font-size: 1.75rem;
    }
  }
</style>
